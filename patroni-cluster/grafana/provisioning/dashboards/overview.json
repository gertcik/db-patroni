{
  "title": "Patroni Cluster Overview",
  "uid": "patroni-overview",
  "tags": ["patroni", "postgresql", "haproxy", "docker"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Patroni Cluster",
      "type": "row"
    },
    {
      "id": 2,
      "title": "Current Master",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "background" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "patroni1", "color": "green" } } },
            { "type": "value", "options": { "2": { "text": "patroni2", "color": "green" } } },
            { "type": "value", "options": { "3": { "text": "patroni3", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "patroni_master == 1",
          "legendFormat": "{{member}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Cluster Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 3 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "count(up{job=\"patroni\"} == 1)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Replication Lag (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "patroni_lag{member=~\"patroni.*\"}",
          "legendFormat": "{{member}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "panels": [],
      "title": "PostgreSQL",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 80 }]
          }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"shop\"}",
          "legendFormat": "{{instance}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Transactions / sec",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"shop\"}[5m])",
          "legendFormat": "commit {{instance}}"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"shop\"}[5m])",
          "legendFormat": "rollback {{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 95 }, { "color": "green", "value": 99 }]
          }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "(sum(rate(pg_stat_database_blks_hit{datname=\"shop\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"shop\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"shop\"}[5m])))) * 100",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 9,
      "title": "DB Size (shop)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "none" },
          "unit": "bytes",
          "mappings": []
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"shop\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 10,
      "panels": [],
      "title": "HAProxy",
      "type": "row"
    },
    {
      "id": 11,
      "title": "Backend Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 13 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              }
            }
          ]
        }
      },
      "options": {
        "sortBy": []
      },
      "targets": [
        {
          "expr": "haproxy_server_up{backend=\"patroni_back\"}",
          "legendFormat": "{{server}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Current Sessions",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 13 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "haproxy_frontend_current_sessions{frontend=\"patroni_front\"}",
          "legendFormat": "{{frontend}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 13 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(haproxy_frontend_requests_total{frontend=\"patroni_front\"}[5m])",
          "legendFormat": "{{frontend}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 14,
      "panels": [],
      "title": "System Resources (cadvisor)",
      "type": "row"
    },
    {
      "id": 15,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "percent"
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m]) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "Memory RSS",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "bytes"
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "container_memory_rss{name=~\".+\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 17,
      "title": "Network I/O",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 27 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "Bps"
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name=~\".+\"}[5m])",
          "legendFormat": "RX {{name}}"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\".+\"}[5m])",
          "legendFormat": "TX {{name}}"
        }
      ]
    }
  ],
  "schemaVersion": 34,
  "version": 1
}