{
  "title": "HAProxy",
  "uid": "haproxy-prometheus",
  "tags": ["haproxy", "loadbalancer"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend Servers Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              }
            }
          ]
        }
      },
      "options": { "sortBy": [] },
      "targets": [
        {
          "expr": "haproxy_server_status{state=\"UP\"}",
          "legendFormat": "{{proxy}}/{{server}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Current Sessions by Frontend",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "haproxy_frontend_current_sessions",
          "legendFormat": "{{frontend}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(haproxy_frontend_http_requests_total[5m])",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Backend Response Time",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "ms"
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "haproxy_backend_response_time_average_seconds",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Bytes In / Out",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "bytes"
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(haproxy_frontend_bytes_in_total[5m])",
          "legendFormat": "IN {{proxy}}"
        },
        {
          "expr": "rate(haproxy_frontend_bytes_out_total[5m])",
          "legendFormat": "OUT {{proxy}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Connection Errors",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" }
        }
      },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "rate(haproxy_backend_connection_errors_total[5m])",
          "legendFormat": "{{proxy}} {{server}}"
        }
      ]
    }
  ],
  "schemaVersion": 34,
  "version": 1
}